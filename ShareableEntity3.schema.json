{
   "$schema":"http://json-schema.org/draft-07/schema#",
   "$id":"#ShareableEntity3",
   "title":"ShareableEntity3",
   "description":"DOME extensions for TMForum entities that needs to be shared across Access Nodes",
   "type":"object",
   "required":[
      "relatedParty"
   ],
   "properties":{
      "cloudesireProductVersionId":{
         "type":"number",
         "description":"CloudeSire product version identifier"
      },
      "pricingLogicAlgorithm":{
         "$ref":"https://raw.githubusercontent.com/DOME-Marketplace/tmf-api/refs/heads/main/schemas/Product/PricingLogicAlgorithm.schema.json"
      },
      "relatedParty":{
         "type":"array",
         "description":"List of related parties",
         "items":{
            "$ref":"https://raw.githubusercontent.com/DOME-Marketplace/tmf-api/refs/heads/main/schemas/EngagedParty/RelatedParty.schema.json#RelatedParty"
         }
      }
   }
}
